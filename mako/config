# Глобальные настройки
max-visible=5
sort=-time
layer=top
anchor=top-right

# Геометрия и отступы
width=300
height=110
margin=20
padding=15
border-size=2
border-radius=8

# Шрифты и цвета (пример под темную тему)
font=monospace 10
background-color=#1e1e2e00
text-color=#cdd6f4
border-color=#89b4fa
progress-color=over #313244

# Иконки
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Papirus-Dark

# Время отображения (в миллисекундах, 0 — не скрывать автоматически)
default-timeout=5000

# Специфичные правила для разных типов уведомлений
[urgency=high]
border-color=#f38ba8
default-timeout=0

[urgency=low]
border-color=#a6e3a1
default-timeout=2000