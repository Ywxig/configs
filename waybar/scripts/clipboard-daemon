#!/usr/bin/env python3
"""Демон истории буфера обмена для Wayland.

Слушает изменения выделения через `wl-paste --watch` и складывает
текстовые записи в ~/.cache/clipboard-history/history.json.

Режимы:
    clipboard-daemon            запустить демон (единственный экземпляр)
    clipboard-daemon store      принять текст из stdin (используется watch)
    clipboard-daemon count      вывести число записей (для waybar)
    clipboard-daemon clear      очистить историю
"""

import fcntl
import os
import signal
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import clipboard_store as store

SCRIPT = os.path.abspath(__file__)
DAEMON_LOCK = os.path.join(store.CACHE_DIR, "daemon.lock")


def read_stdin_text():
    try:
        data = sys.stdin.buffer.read()
    except (OSError, ValueError):
        return None

    if not data or b"\x00" in data:
        return None

    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        return None

    # wl-paste может добавлять завершающий перевод строки — не считаем его частью.
    if text.endswith("\r\n"):
        text = text[:-2]
    elif text.endswith("\n"):
        text = text[:-1]
    return text


def seed_from_current_clipboard():
    try:
        proc = subprocess.run(
            ["wl-paste", "--no-newline"],
            capture_output=True,
            timeout=2,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return
    if proc.returncode != 0 or not proc.stdout:
        return
    try:
        text = proc.stdout.decode("utf-8")
    except UnicodeDecodeError:
        return
    if text.strip():
        store.add(text)


def run_daemon():
    os.makedirs(store.CACHE_DIR, mode=0o700, exist_ok=True)
    lock_fd = os.open(DAEMON_LOCK, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0

    watcher = None

    def stop(_signum, _frame):
        if watcher is not None and watcher.poll() is None:
            watcher.terminate()
            try:
                watcher.wait(timeout=2)
            except subprocess.TimeoutExpired:
                watcher.kill()
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    seed_from_current_clipboard()

    while True:
        try:
            watcher = subprocess.Popen(
                ["wl-paste", "--watch", sys.executable, SCRIPT, "store"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            watcher.wait()
        except FileNotFoundError:
            print("clipboard-daemon: не найден wl-paste (пакет wl-clipboard)", file=sys.stderr)
            return 1
        except SystemExit:
            raise

        # Композитор/порт wl-clipboard мог перезапуститься — поднимаем watcher снова.
        time.sleep(1)


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "daemon"

    if mode == "store":
        text = read_stdin_text()
        if text is not None and text.strip():
            store.add(text)
        return 0

    if mode == "count":
        n = store.count()
        print(n if n else "")
        return 0

    if mode == "clear":
        store.clear()
        return 0

    if mode == "daemon":
        return run_daemon()

    print(f"clipboard-daemon: неизвестный режим {mode!r}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
