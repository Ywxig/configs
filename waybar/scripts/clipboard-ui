#!/usr/bin/env python3
"""История буфера обмена — всплывающее окно GTK3 + gtk-layer-shell.

Возможности:
  • поиск по всей истории;
  • клик или Enter — скопировать запись;
  • Ctrl+Delete — удалить выбранную, Ctrl+Shift+Delete — очистить всё;
  • Esc — закрыть.

Историю наполняет clipboard-daemon (wl-paste --watch).
"""

import os
import subprocess
import sys
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, Gio, GLib, Gtk, GtkLayerShell, Pango  # noqa: E402

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import clipboard_store as store  # noqa: E402

APP_ID = "org.dima.ClipboardHistory"
TEST_MODE = os.environ.get("CLIPBOARD_UI_TEST") == "1"
TOP_MARGIN = int(os.environ.get("CLIPBOARD_UI_TOP_MARGIN", "44"))

CSS = b"""
window { background-color: transparent; }

.panel {
    background-color: rgba(26, 27, 38, 0.97);
    border: 1px solid rgba(122, 162, 247, 0.55);
    border-radius: 14px;
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.55);
    padding: 12px;
}

.header { margin-bottom: 8px; }

.title-icon {
    color: #7aa2f7;
    font-size: 18px;
    font-weight: bold;
}

.title {
    color: #c0caf5;
    font-size: 14px;
    font-weight: bold;
}

